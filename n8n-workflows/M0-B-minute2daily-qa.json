      "id": "get-minute",
      "name": "获取分钟线",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        960,
        440
      ]
    },
    {
      "parameters": {
        "jsCode": "const run = $node[\"运行Runner\"].json;\nconst journalWrap = $node[\"获取RunJournal\"].json;\nconst journal = journalWrap?.journal || null;\nconst minute = $node[\"获取分钟线\"].json;\n\nconst iconMap = { success: '✅', partial: '⚠️', failed: '❌' };\nconst icon = iconMap[run.status] || '❓';\n\nconst asOfStr = String(run.asOf || '');\nconst asOf = asOfStr.includes('T') ? asOfStr.split('T')[1].slice(0,5) : '15:00';\n\nconst series = Array.isArray(minute.series) ? minute.series : [];\nconst pts = series.length;\nconst last = pts ? series[pts - 1] : null;\nconst close = last?.close ?? null;\nconst amt = 0;\n\nconst hasCloseBar = !!(last?.time && String(last.time).includes('15:00'));\nconst amountOk = amt > 0;\nconst prevClose = minute.prevClose;\nconst pctOk = prevClose != null && Number(prevClose) > 0;\n\nlet failStep = 'None';\nlet err = 'None';\nif (journal && Array.isArray(journal.steps)) {\n  const failed = journal.steps.find(s => s.status === 'failed');\n  if (failed) {\n    failStep = failed.name;\n    err = failed.error?.message || (failed.warnings || []).find(w => w.severity === 'error')?.message || 'failed';\n  }\n}\n\nconst line1 = `M0-B ${icon} day=${run.day} asOf=${asOf} symbol=${$node[\"设置参数\"].json.symbol}`;\nconst line2 = `pts=${pts} close=${close ?? 'NA'} amt=${amt}`;\nconst line3 = `QA: closeBar=${hasCloseBar ? 'Y' : 'N'} amountOk=${amountOk ? 'Y' : 'N'} pctOk=${pctOk ? 'Y' : 'N'} out: minute2daily + qa (err=${err})`;\n\nreturn [{ line1, line2, line3, summary: `${line1}\\n${line2}\\n${line3}` }];\n"
      },
      "id": "summary",
      "name": "3行摘要",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        260
      ]
    }
