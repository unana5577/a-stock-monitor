{
  "name": "M1-E-Backfill-Universal (18:00 & 09:00)",
  "nodes": [
    {
      "id": "trigger-evening",
      "name": "18:00触发",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [0, 0],
      "parameters": { "rule": { "interval": [ { "field": "cronExpression", "expression": "0 18 * * 1-5" } ] } }
    },
    {
      "id": "trigger-morning",
      "name": "09:00触发",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [0, 150],
      "parameters": { "rule": { "interval": [ { "field": "cronExpression", "expression": "0 9 * * 1-5" } ] } }
    },
    {
      "id": "manual",
      "name": "手动触发",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 300]
    },
    {
      "id": "fetch-list",
      "name": "获取ETF清单(API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [200, 150],
      "parameters": {
        "method": "GET",
        "url": "http://a-stock-v2:8788/api/sector/manage",
        "sendBody": false,
        "options": {}
      }
    },
    {
      "id": "set-symbols",
      "name": "生成全量清单（指数+ETF）",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 150],
      "parameters": {
        "jsCode": "const data = $input.item.json;\nconst etfs = data.etfs || {};\nconst indexSymbols = ['sh000001', 'sz399001', 'sz399006', 'sh000688', 'sh000300', 'sh000852'];\nconst etfSymbols = Object.keys(etfs).filter(k => !etfs[k].hidden);\nconst all = [...indexSymbols, ...etfSymbols];\nreturn all.map(s => ({ json: { symbol: s } }));"
      }
    },
    {
      "id": "http",
      "name": "调用本地回补脚本",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [600, 150],
      "parameters": {
        "method": "POST",
        "url": "http://a-stock-v2:8788/api/m1/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"script\": \"m1_backfill.py\",\n  \"symbol\": \"{{ $json.symbol }}\",\n  \"applyFix\": true,\n  \"expectEnd\": \"{{ $today.toFormat('yyyy-MM-dd') }}\"\n}",
        "options": {}
      }
    },
    {
      "id": "parse",
      "name": "输出执行结果",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 150],
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  let raw = item.json.stdout ? item.json.stdout.join('\\n') : '';\n  let summary = `M1-Backfill ✅ 无增量更新`;\n  if (raw.includes('[接口拉取] 成功获取')) {\n    const countMatch = raw.match(/成功获取 (\\d+) 条/);\n    const datesMatch = raw.match(/\\[合并完成\\] (.*?) 补充日期: (.*)/);\n    if (countMatch && datesMatch) {\n      summary = `M1-Backfill ✅ 回补成功\\n${datesMatch[1]} 新增 ${countMatch[1]} 条: ${datesMatch[2]}`;\n    }\n  } else if (raw.includes('❌')) {\n    summary = `M1-Backfill ❌ 失败`;\n  }\n  return { json: { summary } };\n});"
      }
    },
    {
      "id": "trigger-warmup",
      "name": "触发晚间分析",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1000, 150],
      "parameters": {
        "method": "POST",
        "url": "http://a-stock-v2:8788/api/m1/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"script\": \"m1_warmup.py\"\n}",
        "options": {}
      }
    },
    {
      "id": "trigger-lifecycle",
      "name": "触发晚间周期",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1200, 150],
      "parameters": {
        "method": "POST",
        "url": "http://a-stock-v2:8788/api/m1/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"script\": \"m1_lifecycle.py\"\n}",
        "options": {}
      }
    }
  ],
  "connections": {
    "18:00触发": { "main": [ [ { "node": "获取ETF清单(API)", "type": "main", "index": 0 } ] ] },
    "09:00触发": { "main": [ [ { "node": "获取ETF清单(API)", "type": "main", "index": 0 } ] ] },
    "手动触发": { "main": [ [ { "node": "获取ETF清单(API)", "type": "main", "index": 0 } ] ] },
    "获取ETF清单(API)": { "main": [ [ { "node": "生成全量清单（指数+ETF）", "type": "main", "index": 0 } ] ] },
    "生成全量清单（指数+ETF）": { "main": [ [ { "node": "调用本地回补脚本", "type": "main", "index": 0 } ] ] },
    "调用本地回补脚本": { "main": [ [ { "node": "输出执行结果", "type": "main", "index": 0 } ] ] },
    "输出执行结果": { "main": [ [ { "node": "触发晚间分析", "type": "main", "index": 0 } ] ] },
    "触发晚间分析": { "main": [ [ { "node": "触发晚间周期", "type": "main", "index": 0 } ] ] }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
