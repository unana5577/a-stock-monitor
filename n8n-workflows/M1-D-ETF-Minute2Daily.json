{
  "name": "M1-D-ETF-Minute2Daily (15:01 日线合成)",
  "nodes": [
    {
      "id": "trigger",
      "name": "盘后触发",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [0, 100],
      "parameters": {
        "rule": { "interval": [ { "field": "cronExpression", "expression": "1 15 * * 1-5" } ] }
      }
    },
    {
      "id": "manual",
      "name": "手动触发",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 250]
    },
    {
      "id": "code",
      "name": "要合成日线的ETF列表",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 100],
      "parameters": {
        "jsCode": "const symbols = ['sh511130', 'sh511260', 'sh512480'];\nreturn symbols.map(s => ({ json: { symbol: s } }));"
      }
    },
    {
      "id": "http",
      "name": "执行合成脚本",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [400, 100],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8787/api/m1/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"script\": \"m1_minute_to_daily_etf.py\",\n  \"symbol\": \"{{ $json.symbol }}\",\n  \"day\": \"{{ $today.toFormat('yyyy-MM-dd') }}\"\n}",
        "options": {}
      }
    },
    {
      "id": "parse",
      "name": "输出日志",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 100],
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  let raw = item.json.stdout ? item.json.stdout.join('\\n') : '';\n  let summary = `M1-D ❌ 未知错误`;\n  if (raw.includes('成功！生成了')) {\n    const match = raw.match(/成功！生成了 (.*) 的 ETF 日线: (.*)/);\n    if (match) {\n      summary = `M1-D ✅ day=${match[1]}\\n合并ETF日线成功: ${match[2]}`;\n    }\n  } else if (raw.includes('❌')) {\n    const match = raw.match(/❌ (.*)/);\n    if (match) summary = `M1-D ❌ 失败: ${match[1]}`;\n  }\n  return { json: { summary } };\n});"
      }
    }
  ],
  "connections": {
    "盘后触发": { "main": [ [ { "node": "要合成日线的ETF列表", "type": "main", "index": 0 } ] ] },
    "手动触发": { "main": [ [ { "node": "要合成日线的ETF列表", "type": "main", "index": 0 } ] ] },
    "要合成日线的ETF列表": { "main": [ [ { "node": "执行合成脚本", "type": "main", "index": 0 } ] ] },
    "执行合成脚本": { "main": [ [ { "node": "输出日志", "type": "main", "index": 0 } ] ] }
  },
  "settings": {
    "executionOrder": "v1"
  }
}