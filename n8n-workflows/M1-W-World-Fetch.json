{
  "name": "M1-W-World-Fetch (1m 外盘: 日经/KOSPI/恒生)",
  "nodes": [
    {
      "id": "cron-1m",
      "name": "每分钟触发",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "* 8-16 * * 1-5" }
          ]
        }
      }
    },
    {
      "id": "manual",
      "name": "手动触发",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 160],
      "parameters": {}
    },
    {
      "id": "params-normal",
      "name": "参数(常规)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [220, 0],
      "parameters": {
        "values": {
          "string": [
            { "name": "symbols", "value": "N225,KS11,HSI" }
          ],
          "boolean": [
            { "name": "force", "value": false }
          ]
        }
      }
    },
    {
      "id": "params-manual",
      "name": "参数(手动)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [220, 160],
      "parameters": {
        "values": {
          "string": [
            { "name": "symbols", "value": "N225,KS11,HSI" }
          ],
          "boolean": [
            { "name": "force", "value": true }
          ]
        }
      }
    },
    {
      "id": "fetch",
      "name": "落盘外盘分时",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 80],
      "parameters": {
        "method": "POST",
        "url": "http://a-stock-v2:8788/api/m1/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"script\": \"m1_world_fetch.py\",\n  \"symbols\": \"{{ $json.symbols }}\",\n  \"day\": \"{{ $today.toFormat('yyyy-MM-dd') }}\",\n  \"force\": {{ $json.force ? 'true' : 'false' }}\n}",
        "options": {}
      }
    },
    {
      "id": "out",
      "name": "输出日志",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 80],
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  let raw = item.json.stdout ? item.json.stdout.join('') : '{}';\n  let parsed = {};\n  try { parsed = JSON.parse(raw); } catch(e) {}\n\n  let summary = `M1-W ❌ 未知错误`;\n  if (parsed.skipped && parsed.reason) {\n    summary = `M1-W ⏭️ day=${parsed.day} asOf=${parsed.asOf}\\n跳过: ${parsed.reason}`;\n  } else if (parsed.ok) {\n    summary = `M1-W ✅ day=${parsed.day} asOf=${parsed.asOf}\\n成功落盘: ${(parsed.wrote || []).join(', ') || '无'}\\n跳过: ${JSON.stringify(parsed.skipped || [])}`;\n  }\n\n  return { json: { summary } };\n});"
      }
    }
  ],
  "connections": {
    "每分钟触发": { "main": [[{ "node": "参数(常规)", "type": "main", "index": 0 }]] },
    "手动触发": { "main": [[{ "node": "参数(手动)", "type": "main", "index": 0 }]] },
    "参数(常规)": { "main": [[{ "node": "落盘外盘分时", "type": "main", "index": 0 }]] },
    "参数(手动)": { "main": [[{ "node": "落盘外盘分时", "type": "main", "index": 0 }]] },
    "落盘外盘分时": { "main": [[{ "node": "输出日志", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
