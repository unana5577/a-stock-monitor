{
  "name": "5分钟刷新市场快照",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "定时触发器",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [220, 400]
    },
    {
      "parameters": {
        "jsCode": "const now = $now.setZone('Asia/Shanghai');\nconst weekday = now.weekday;\nconst minutes = now.hour * 60 + now.minute;\nconst isWeekday = weekday >= 1 && weekday <= 5;\nconst inMorning = minutes >= 570 && minutes <= 690;\nconst inAfternoon = minutes >= 780 && minutes <= 900;\nreturn [{\n  now: now.toISO(),\n  isWeekday,\n  inTradingTime: isWeekday && (inMorning || inAfternoon)\n}];\n"
      },
      "id": "calc-trading-time",
      "name": "计算交易时段",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 400]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.inTradingTime }}",
              "operation": "isTrue"
            }
          ]
        }
      },
      "id": "if-trading-time",
      "name": "是否交易时段",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [700, 400]
    },
    {
      "parameters": {
        "command": "python3 scripts/market_snapshot_sina.py",
        "cwd": "/Users/una5577/Documents/trae_projects/a-stock-monitor"
      },
      "id": "execute-snapshot",
      "name": "执行市场快照",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [940, 380]
    }
  ],
  "connections": {
