        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = ($json.stdout ?? $json.data ?? '').trim();\nif (!raw) throw new Error('Runner stdout is empty');\nconst obj = JSON.parse(raw);\nconst root = '/Users/una5577/Documents/trae_projects/a-stock-monitor/';\nreturn [{\n  ...obj,\n  journalAbs: root + obj.journal,\n  qaAbs: obj.qa ? (root + obj.qa) : null,\n}];\n"
      },
      "id": "parse-stdout",
      "name": "解析stdout",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        300
      ]
    },
    {
      "parameters": {
        "filePath": "={{ $json.journalAbs }}"
      },
      "id": "read-journal",
      "name": "读取RunJournal",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        980,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $binary?.data?.data;\nif (!b) throw new Error('journal binary is empty');\nconst txt = Buffer.from(b, 'base64').toString('utf-8');\nreturn [{ journal: JSON.parse(txt) }];\n"
      },
      "id": "decode-journal",
      "name": "解码RunJournal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        300
      ]
    }
